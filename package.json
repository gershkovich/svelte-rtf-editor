{
	"name": "svelte-rtf-editor",
	"version": "1.9.0",
	"description": "RTF viewer and rich-text editor components for Svelte 5",
	"license": "MIT",
	"homepage": "https://github.com/jcelano/svelte-rtf-editor#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jcelano/svelte-rtf-editor.git"
	},
	"bugs": "https://github.com/jcelano/svelte-rtf-editor/issues",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "npm run prepack && changeset publish",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@changesets/cli": "^2.30.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/kit": "^3.3.1",
		"@sveltejs/package": "^3.0.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@vitest/coverage-v8": "^4.0.18",
		"happy-dom": "^21.0.4",
		"publint": "^0.3.18",
		"svelte": "^5.58.0",
		"svelte-check": "^4.4.4",
		"typescript": "^6.0.0",
		"vite": "^8.0.12",
		"vitest": "^4.0.18"
	},
	"keywords": [
		"svelte",
		"rtf",
		"editor",
		"rich-text",
		"contenteditable",
		"viewer"
	]
}
